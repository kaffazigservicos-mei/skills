# =========================================================================
# CONFIGURAÇÕES DA SKILL SINCONECTA1
# Instruções: Duplique este arquivo, renomeie para .env e insira suas chaves.
# =========================================================================

# Credenciais de Conexão com o Banco de Dados (Supabase/Backend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# Parâmetros de Notificação e Inteligência Operacional
VITE_TELEGRAM_BOT_TOKEN=seu_token_do_bot_aqui
VITE_TELEGRAM_CHAT_ID=seu_id_de_chat_ou_canal_aqui

# Ambiente de Execução
VITE_ENVIRONMENT=production
